set shell := ["bash", "-euo", "pipefail", "-c"]

compose := "docker compose -f deploy/docker-compose.yml"

default:
    @just --list

# Regenerate Go and Python stubs. Rust types are generated by crates/drift-proto/build.rs.
gen:
    rm -rf gen/go/drift gen/python/src/drift
    cd proto && buf generate

build: build-go build-rust build-python

build-go:
    go build ./orchestrator/... ./analyzers/meta-go/... ./gen/go/...
    cd deploy/fixture-registry && GOWORK=off go build ./...

build-rust:
    cargo build --workspace --locked

build-python:
    uv sync --all-packages --locked

test: test-go test-rust test-python test-hooks

test-go:
    go test ./orchestrator/... ./analyzers/meta-go/...
    cd deploy/fixture-registry && GOWORK=off go test ./...

test-rust:
    cargo test --workspace --locked

test-python:
    uv run --all-packages --locked pytest

# Guard hook tests. They feed commands to the hook and execute nothing.
test-hooks:
    .claude/hooks/test-hooks.sh

lint: lint-proto lint-go lint-rust lint-python lint-workflows

lint-proto:
    buf lint proto

# Fail if the schema breaks compared to a git ref. Skipped if the ref has no schema yet.
proto-breaking ref="main":
    if git cat-file -e "{{ ref }}:proto/buf.yaml" 2>/dev/null; then \
        buf breaking proto --against ".git#ref={{ ref }},subdir=proto"; \
    else \
        echo "no proto schema at {{ ref }}, skipping"; \
    fi

lint-go:
    test -z "$(gofmt -l orchestrator analyzers deploy/fixture-registry)"
    cd orchestrator && golangci-lint run ./...
    cd analyzers/meta-go && golangci-lint run ./...
    cd deploy/fixture-registry && GOWORK=off golangci-lint run ./...

lint-rust:
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --locked -- -D warnings

lint-python:
    uv run --all-packages --locked ruff check .
    uv run --all-packages --locked ruff format --check .
    uv run --all-packages --locked mypy scorer/src eval/src

# Check every evaluation manifest. `just test` does this too, through pytest.
validate-manifests:
    uv run --all-packages --locked python -m drift_eval.manifest eval/manifests

lint-workflows:
    actionlint
    zizmor --offline .github

# Build and start every service in the background.
up:
    {{ compose }} up --build --detach
    @echo "Orchestrator log: just logs"

# Stops everything, including the fixture registry, and deletes the volumes.
down:
    {{ compose }} --profile fixtures down --volumes

logs service="orchestrator":
    {{ compose }} logs {{ service }}

# Run the CLI in the orchestrator container: just drift analyze npm chalk --from 5.3.0 --to 5.4.0
# The analyzers it calls are started first if they aren't running.
[positional-arguments]
drift *args:
    @# Not run --build: it prints build progress on stdout, mixed into the CLI's JSON.
    {{ compose }} build >&2
    {{ compose }} run --rm --entrypoint /drift orchestrator "$@"

# Replay a synthetic incident end to end via the fixture registry, e.g. package=drift-fixture-dep-inject.
demo-fixture package="drift-fixture-install-hook":
    {{ compose }} --profile fixtures up --build --detach fixture-registry >&2
    just drift analyze npm {{ package }} --from 1.0.0 --to 1.0.1 --registry http://fixture-registry:8080

# Check static-rs's time budget (under 5 s for a package under 5 MB) in a release build.
bench-static:
    cargo test --release --locked -p static-rs --test golden typical_package -- --ignored --nocapture

# Fuzz the unpacker (needs nightly and cargo-fuzz). The attack archives seed the corpus.
fuzz seconds="1800":
    mkdir -p crates/safe-unpack/fuzz/corpus/unpack
    cd crates/safe-unpack && cargo +nightly fuzz run unpack fuzz/corpus/unpack tests/attacks -- \
        -max_total_time={{ seconds }} -timeout=10 -rss_limit_mb=2048
